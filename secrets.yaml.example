# Copy to secrets.yaml (same folder) and fill it in. Do NOT commit secrets.yaml.

# 32 byte base64 key for the HA native API (also used to encrypt OTA updates). Generate with
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY="

# Your OmniX site securityKey (the UUID Hayward issued for your site). Hyphens are optional.
# This is the 16 byte AES key the pump uses for BLE. Treat it like a password.
# Replace the zeros with YOUR_SITE_SECURITY_KEY_HERE (your own UUID, never someone else's).
pump_aes_key: "00000000-0000-0000-0000-000000000000"
